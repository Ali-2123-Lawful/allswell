# Allswell configuration. Copy to .env and edit as needed.
# Everything here is optional: with no .env at all the app runs the full demo
# (built-in scenario simulator + templated digest, no keys, no network).

# --- Amazon Bedrock digest phrasing (AWS Builder) ----------------------------
# 1 = ask Amazon Bedrock to phrase the daily digest; 0 = zero-cost template.
# Needs `pip install boto3` and AWS access, and falls back to the template on
# any error.
ALLSWELL_USE_BEDROCK=0
# AWS region whose Bedrock endpoint is called.
AWS_REGION=us-east-1
# Bedrock model or inference-profile ID. Must be enabled in your AWS account.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Credentials: a Bedrock API key, or the standard AWS chain (access keys,
# ~/.aws/credentials, SSO profiles, ...). Never commit real values.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
