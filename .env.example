# Allswell configuration — copy to .env and fill in as needed.
# The app runs with ZERO config out of the box (uses the built-in scenario simulator
# and the templated digest). Set these only to go further.

# --- Amazon Bedrock (optional, off by default) ------------------------------
# Set to 1 to have Bedrock phrase the digests. Requires: pip install "anthropic[bedrock]" + AWS credentials.
ALLSWELL_USE_BEDROCK=0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
# AWS credentials come from the standard chain (env vars, ~/.aws/credentials, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
