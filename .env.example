# Allswell configuration. Copy to .env and edit as needed.
# Everything here is optional: with no .env at all the app runs the full demo
# (built-in scenario simulator + templated digest, no keys, no network).

# --- Amazon Bedrock digest phrasing (optional, off by default) ---------------
# 1 = ask Amazon Bedrock to phrase the daily digest; 0 = zero-cost template.
# Needs `pip install "anthropic[bedrock]"` plus AWS credentials, and falls back
# to the template on any error. Not used in the hackathon demo.
ALLSWELL_USE_BEDROCK=0
# AWS region whose Bedrock endpoint is called.
AWS_REGION=us-east-1
# Bedrock model ID used for the phrasing.
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
# AWS credentials come from the standard AWS chain (these variables,
# ~/.aws/credentials, SSO profiles, ...). Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
